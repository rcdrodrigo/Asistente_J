# Configuración JARVIS para Windows

# LiveKit (requerido para voz)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Configuración de voz
ENABLE_VOICE=false
VOICE_PROVIDER=livekit  # livekit, elevenlabs, openai
VOICE_MODEL=nova
VOICE_LANGUAGE=es

# STT (Speech-to-Text)
STT_PROVIDER=deepgram  # deepgram, whisper
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# TTS (Text-to-Speech)
TTS_PROVIDER=elevenlabs  # elevenlabs, cartesia
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# Configuración del Agente
AGENT_MODE=local  # local, cloud o hybrid
AGENT_NAME=JARVIS
AGENT_LANGUAGE=es

# Configuración de LM Studio (local)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_MAX_TOKENS=2000

# Configuración de OpenAI (opcional para modo cloud/hybrid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Configuración de seguridad
ENABLE_CODE_EXECUTION=true
ENABLE_SYSTEM_COMMANDS=false

# Configuración de herramientas
ENABLE_FILE_OPERATIONS=true
ENABLE_GIT_OPERATIONS=true
ENABLE_DOCUMENTATION=true
MAX_FILE_SIZE_MB=10
ALLOWED_DIRECTORIES=C:\\Users\\%USERNAME%\\jarvis-workspace,C:\\temp
SANDBOX_TYPE=restricted
CODE_EXECUTION_TIMEOUT=30
MAX_MEMORY_MB=512

# Configuración de Redis (opcional para caché)
REDIS_URL=redis://localhost:6379
ENABLE_CACHE=true
CACHE_TTL=3600

# Configuración de logs
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=logs/jarvis.log
